{
  "name": "qiban-windows",
  "productName": "栖伴测试版",
  "version": "0.9.0-beta.1",
  "description": "栖伴目标与成长记录四端测试版",
  "author": "Qiban",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "smoke": "node smoke.cjs",
    "dist": "node build.cjs"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "io.github.ciki9876.qiban.dev",
    "productName": "栖伴测试版",
    "asar": true,
    "toolsets": { "nsis": "1.2.1" },
    "directories": { "output": "../../artifacts/windows" },
    "files": ["main.cjs", "preload.cjs", "native-core.cjs", "package.json"],
    "extraResources": [{ "from": "../../dist/windows", "to": "web", "filter": ["**/*"] }],
    "win": {
      "icon": "icon.ico",
      "signExecutable": false,
      "target": [{ "target": "nsis", "arch": ["x64"] }, { "target": "zip", "arch": ["x64"] }],
      "artifactName": "Qiban-${version}-windows-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "Qiban-${version}-windows-x64-setup.${ext}"
    },
    "publish": null
  }
}
